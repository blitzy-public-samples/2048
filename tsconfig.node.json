// TypeScript configuration for the tooling sources: the four root config
// files — vite.config.ts, vitest.config.ts, vitest.snapshot.config.ts and
// playwright.config.ts — each executed by its own tool's loader. No file here
// reads a Node global. tsconfig.json covers the browser-context sources, the
// Playwright specs under tests/e2e/ included, so the two projects partition the
// repository's root file set and share no root file. `npm run typecheck` runs
// both in sequence.
//
// Supersedes .jshintrc, which is deleted along with Rakefile, the only other
// build-tooling file the repository had. One .jshintrc check has a compiler
// equivalent and is carried forward here: `unused: true` becomes the two
// unused-symbol options below. Its `indent: 2` and `maxlen: 80` have none — no
// option in this file, and no package in the dependency set, enforces
// indentation or line length. The Node-context sources follow both conventions
// by authoring discipline.
{
  "compilerOptions": {
    // Language level of the Node runtime .nvmrc and `engines.node` pin.
    "target": "ES2023",

    // src/theme/tokens.ts, which vite.config.ts imports for the Sass token
    // projection, is a browser-context module and enters this project through
    // that import. This list matches tsconfig.json's DOM libraries so the one
    // module is checked identically by both projects.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],

    // Resolution matches tsconfig.json; `vite`, `vitest/config` and
    // `@playwright/test` resolve through their packages' export maps.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,

    // Ambient type packages: none. No file in this project reads a Node
    // global, and an empty list also stops the packages under
    // node_modules/@types being auto-included, so no ambient global reaches
    // these files implicitly and the installed `@types/seedrandom` and
    // `@types/three` — both browser-context declarations — stay out of this
    // project. package.json declares no @types/node dependency. `vite`,
    // `vitest/config` and `@playwright/test` are typed through their own
    // resolved declaration packages, which this list does not affect, and the
    // `/// <reference types="node" />` in vite's own declaration entry point is
    // covered by `skipLibCheck` below.
    "types": [],

    // Permits the explicit `.ts` specifier vite.config.ts uses to reach
    // src/theme/tokens.ts. Matches tsconfig.json, which declares the same
    // option for the two application modules that chain carries.
    "allowImportingTsExtensions": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,

    // Each file is emitted in isolation, so type-only syntax is written
    // explicitly rather than elided.
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,

    "skipLibCheck": true,

    // Type gate only: Vite, Vitest and Playwright each transpile their own
    // config as they load it.
    "noEmit": true
  },

  // The tooling file set, listed exhaustively: the four root configuration
  // files and nothing else. src/, js/ and every tests/ subtree — tests/e2e
  // included — are unmatched here; tsconfig.json's `tests/**/*.ts` pattern
  // claims them.
  //
  // A module a config file imports still enters this project through that
  // import: vite.config.ts imports src/theme/tokens.ts for the Sass token
  // projection, so tokens.ts and the src/config modules it reads are checked
  // here as well as under tsconfig.json.
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.snapshot.config.ts",
    "playwright.config.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "test-results",
    "playwright-report",
    "blitzy",
    "blitzy-deck"
  ]
}
