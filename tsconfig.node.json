// TypeScript configuration for the Node-context sources: the four root
// tooling configs and the Playwright specs under tests/e2e/. Those files
// import from `vite`, `vitest/config` and `@playwright/test`, and each is
// executed by its own tool's loader.
//
// tsconfig.json covers the browser-context sources — src/ and the DOM-context
// suites under tests/. Between them the two projects claim every TypeScript
// file in the repository, and they share no file. `npm run typecheck` runs
// both in sequence.
//
// Supersedes .jshintrc, which is deleted along with Rakefile, the only other
// build-tooling file the repository had. Three conventions .jshintrc encoded
// are carried forward here: two-space indentation, 80-column lines, and
// `unused: true` as the two unused-symbol checks below.
//
// Rationale for the decisions behind this file: docs/DECISION_LOG.md.
{
  "compilerOptions": {
    // Language level of the Node 24 runtime that .nvmrc and package.json
    // `engines.node` pin.
    "target": "ES2023",

    // The `page.evaluate()` callbacks in the Playwright specs are authored
    // against browser globals.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],

    // ES module graph, matching package.json `"type": "module"`. Resolution
    // uses the same bundler-style algorithm as tsconfig.json. `vite`,
    // `vitest/config` and `@playwright/test` resolve through their packages'
    // export maps. Every file is a module.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,

    // Ambient type packages. `node` supplies the `process` global that
    // playwright.config.ts reads at four sites, and it satisfies the
    // `/// <reference types="node" />` carried by vite's own declaration
    // entry point. The other installed @types packages are not named here.
    "types": ["node"],

    // Strictness gate. This option set matches tsconfig.json exactly.
    // `npm run typecheck` must report zero diagnostics for both projects.
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,

    // Per-file transpilation contract. This option set matches tsconfig.json
    // exactly: each file stands alone, and type-only syntax is written
    // explicitly rather than elided.
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,

    // Declaration files of the installed packages are not re-checked.
    "skipLibCheck": true,

    // Type gate only. Vite, Vitest and Playwright each transpile their own
    // config as they load it; this project emits nothing, which is what
    // `tsc -p tsconfig.node.json` relies on.
    "noEmit": true
  },

  // The Node-context file set, listed exhaustively. Nothing outside these
  // five patterns enters this project: src/, js/ and the tests/fixtures,
  // tests/unit and tests/snapshot subtrees are all unmatched.
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.snapshot.config.ts",
    "playwright.config.ts",
    "tests/e2e/**/*.ts"
  ],

  // Dependency, build and artifact directories. playwright.config.ts writes
  // into test-results/ and playwright-report/, and the recorded-gameplay
  // artifacts land under blitzy/; none of their contents is source.
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "test-results",
    "playwright-report",
    "blitzy",

    // Self-contained HTML deck with inline script. It enters no TypeScript
    // project and no bundler graph.
    "blitzy-deck"
  ]
}
