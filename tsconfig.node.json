// TypeScript configuration for the Node-context files: the tooling configs
// and the Playwright specs under tests/e2e/. Everything else — src/ and the
// DOM-context suites under tests/ — is covered by tsconfig.json, and the two
// projects share no file.
{
  "compilerOptions": {
    "target": "ES2023",
    // The `page.evaluate()` callbacks in the Playwright specs reference
    // browser globals, which the DOM libraries declare.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.snapshot.config.ts",
    "playwright.config.ts",
    "tests/e2e/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
