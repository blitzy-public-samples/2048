// TypeScript configuration for the tooling sources: the four root config
// files — vite.config.ts, vitest.config.ts, vitest.snapshot.config.ts and
// playwright.config.ts — each executed by its own tool's loader, together with
// the suites that read the filesystem. tsconfig.json covers the browser-context
// sources, the Playwright specs under tests/e2e/ included, so the two projects
// partition the repository's root file set and share no root file.
// `npm run typecheck` runs both in sequence.
//
// Supersedes .jshintrc, deleted along with Rakefile. Its `unused: true` is
// carried forward as the two unused-symbol options below; its `indent: 2` and
// `maxlen: 80` have no compiler equivalent and no package in the dependency set
// enforces them, so the Node-context sources hold both by authoring discipline.
{
  "compilerOptions": {
    // Language level of the Node runtime .nvmrc and `engines.node` pin.
    "target": "ES2023",

    // src/theme/tokens.ts, which vite.config.ts imports for the Sass token
    // projection, is a browser-context module and enters this project through
    // that import. This list matches tsconfig.json's DOM libraries so the one
    // module is checked identically by both projects.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],

    // Resolution matches tsconfig.json; `vite`, `vitest/config` and
    // `@playwright/test` resolve through their packages' export maps.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,

    // Ambient type packages: `node` alone. It is declared for the eight read-only
    // gates listed in `include` below, each of which opens files with `node:fs`.
    // `@types/node` is a package.json devDependency at an exact version, so the
    // entry resolves from the manifest rather than arriving transitively; naming
    // the list at all also stops every other package under node_modules/@types
    // being auto-included, so the browser-context declarations of
    // `@types/seedrandom` and `@types/three` stay out of this project. `vite`,
    // `vitest/config` and `@playwright/test` are typed through their own resolved
    // declaration packages, which this list does not affect, and the
    // `/// <reference types="node" />` in vite's own declaration entry point is
    // covered by `skipLibCheck` below.
    //
    // Declared HERE and not in tsconfig.json, so the application's own type
    // universe stays browser-only and nothing under src/ can reach a Node global.
    // The Playwright specs are not among the files it serves: they import
    // `@playwright/test` and nothing else, reach the recorded video through a
    // browser file input rather than through a `node:` module, and are claimed by
    // tsconfig.json's `tests/**/*.ts`. DL-BUILD-14, DL-PW-06.
    "types": ["node"],

    // Permits the explicit `.ts` specifier vite.config.ts uses to reach
    // src/theme/tokens.ts. Matches tsconfig.json, which declares the same
    // option for the two application modules that chain carries.
    "allowImportingTsExtensions": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,

    // Each file is emitted in isolation, so type-only syntax is written
    // explicitly rather than elided.
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,

    "skipLibCheck": true,

    // Type gate only: Vite, Vitest and Playwright each transpile their own
    // config as they load it.
    "noEmit": true
  },

  // The tooling file set, listed exhaustively: the four root configuration
  // files and the eight read-only gates under tests/unit/quality/ that open
  // files with `node:fs`. Each gate lives under tests/unit/ so `npm test`
  // collects it, and tsconfig.json excludes exactly these eight. src/ is
  // unmatched here, and so is every part of tests/ beyond those eight files —
  // the Playwright specs under tests/e2e/ included; tsconfig.json's
  // `src/**/*.ts` and `tests/**/*.ts` patterns claim all of it.
  //
  // A module a config file imports still enters this project through that
  // import: vite.config.ts imports src/theme/tokens.ts for the Sass token
  // projection, so tokens.ts and the src/config modules it reads are checked
  // here as well as under tsconfig.json.
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.snapshot.config.ts",
    "playwright.config.ts",

    "tests/unit/quality/formatting.test.ts",
    "tests/unit/quality/stylesheet-contract.test.ts",
    "tests/unit/quality/content-security-policy.test.ts",
    "tests/unit/quality/decision-log.test.ts",
    "tests/unit/quality/decision-log-integrity.test.ts",

    // The read-only traceability gate, here for the same reason: it reads
    // docs/TRACEABILITY_MATRIX.md and walks src/, style/, tests/ and the four
    // root configs through `node:fs` to hold the two coverage properties §6 of
    // the matrix states.
    "tests/unit/quality/traceability-matrix.test.ts",

    // The read-only comment gate, here for the same reason: it walks src/,
    // tests/, style/ and the named root files through `node:fs` to hold the
    // comment division AAP 0.9.6 conflict C1 settles.
    "tests/unit/quality/comment-policy.test.ts",

    // The read-only executive-deck gate, here for the same reason: it reads
    // blitzy-deck/executive-summary.html and docs/DECISION_LOG.md through
    // `node:fs` to hold the premises DL-DOC-09's security exception rests on.
    // It parses the deck with `DOMParser`, which the DOM libraries above declare
    // and the jsdom project supplies at run time. DL-TEST-18.
    "tests/unit/quality/executive-deck.test.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "test-results",
    "playwright-report",
    "blitzy",
    "blitzy-deck"
  ]
}
