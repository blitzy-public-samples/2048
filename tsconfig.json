// TypeScript configuration for the browser-context sources: src/ and every
// suite under tests/, the Playwright specs included, because their
// `page.evaluate()` callbacks are authored against DOM globals. The four root
// tooling configs belong to tsconfig.node.json, so the two projects partition
// the repository's root file set. `npm run typecheck` runs both in sequence.
//
// Supersedes the deleted .jshintrc. Its `unused: true` is carried forward as
// the two unused-symbol options below. Its `indent: 2`, `maxlen: 80` and
// `camelcase: true` have no compiler equivalent and no package in the
// dependency set enforces them, so the sources follow those three conventions
// by authoring discipline.
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    // Extensionless relative specifiers resolve here exactly as the bundler
    // resolves them at build time.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,

    // `vite/client` supplies `import.meta.env` and the stylesheet and asset
    // module declarations. `three` and `seedrandom` carry their own declaration
    // packages, so neither is named here.
    "types": ["vite/client"],


    // Permits the explicit `.ts` specifier that vite.config.ts's import chain
    // carries, which Vite's native config loader requires. Available because
    // this project emits nothing.
    "allowImportingTsExtensions": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,

    "skipLibCheck": true,

    // Type gate only: Vite performs the transpilation.
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "test-results",
    "playwright-report",
    "blitzy",
    "blitzy-deck",
    "js",

    // Covered by tsconfig.node.json, which holds the four root configs alone;
    // the Playwright specs stay with the browser-context sources above.
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.snapshot.config.ts",
    "playwright.config.ts",

    // The two read-only quality gates read the tree through `node:fs`, and the
    // stylesheet gate compiles it through the `sass` API, so both are checked
    // under tsconfig.node.json with the `node` types. Excluding them here keeps
    // this project's `types` at `vite/client` alone, which is what stops an
    // application module reaching a Node global.
    "tests/unit/quality/formatting.test.ts",
    "tests/unit/quality/stylesheet-contract.test.ts"
  ]
}
