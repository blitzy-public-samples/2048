// TypeScript configuration for the browser-context sources: src/ and every
// suite under tests/, the Playwright specs included, whose `page.evaluate()`
// callbacks are authored against DOM globals; the seven files that read the
// filesystem are the exception. The four root tooling configs and those
// filesystem readers belong to tsconfig.node.json, so the two projects partition
// the repository's root file set. `npm run typecheck` runs both in sequence.
//
// Supersedes the deleted .jshintrc. Its `unused: true` is carried forward as
// the two unused-symbol options below; its `indent: 2`, `maxlen: 80` and
// `camelcase: true` have no compiler equivalent and no package in the
// dependency set enforces them, so the sources hold all three by authoring
// discipline.
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    // Extensionless relative specifiers resolve here exactly as the bundler
    // resolves them at build time.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,

    // `vite/client` supplies `import.meta.env` and the stylesheet and asset
    // module declarations. `three` and `seedrandom` carry their own declaration
    // packages, so neither is named here.
    "types": ["vite/client"],


    // Permits the explicit `.ts` specifier that vite.config.ts's import chain
    // carries, which Vite's native config loader requires. Available wherever
    // nothing is emitted, as here.
    "allowImportingTsExtensions": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,

    "skipLibCheck": true,

    // Type gate only: Vite performs the transpilation.
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "test-results",
    "playwright-report",
    "blitzy",
    "blitzy-deck",
    "js",

    // Covered by tsconfig.node.json, which holds the four root configs and the
    // suites that read the filesystem.
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.snapshot.config.ts",
    "playwright.config.ts",

    "tests/unit/quality/formatting.test.ts",
    "tests/unit/quality/stylesheet-contract.test.ts",
    "tests/unit/quality/content-security-policy.test.ts",
    "tests/unit/quality/decision-log.test.ts",
    "tests/unit/quality/decision-log-integrity.test.ts",
    "tests/unit/quality/traceability-matrix.test.ts",
    "tests/unit/quality/comment-policy.test.ts",
    "tests/unit/quality/executive-deck.test.ts"
  ]
}
